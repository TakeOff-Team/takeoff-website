---
const stats = [
  { big: '5×', label: 'more inbound leads' },
  { big: '16 → 85+', label: 'leads in 60 days' },
  { big: '2× → 2×', label: 'clicks MoM, Feb & Mar' },
];
---
<section class="proof">
  <div class="proof-container">
    <div class="proof-bridge">
      <h2 class="bridge-h2">Time back is just the floor.</h2>
      <p class="bridge-sub">Champ used his hours to 5× his agency's leads in 60 days.</p>
    </div>

    <div class="proof-grid">
      <div class="proof-stack">
        <div class="proof-text-1">
          <div class="text-artifact" style="--rotate: -3.2deg; --z: 1;">
            <img src="/text-1.jpg" alt="Text message from Champ" />
          </div>
        </div>
        <div class="proof-text-2">
          <div class="text-artifact" style="--rotate: 2.4deg; --z: 2;">
            <img src="/text-2.jpg" alt="Text message from Champ" />
          </div>
        </div>
      </div>

      <div class="stats">
        {stats.map((s, i) => (
          <div class={`stat ${i === 0 ? 'first' : ''}`}>
            <div class="stat-big">{s.big}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>

    <blockquote class="pullquote">
      <span class="quote-mark">&ldquo;</span>I have more than 5x'd this channel via Organic / Paid / LinkedIn. This sh*t is fire.<span class="quote-mark">&rdquo;</span>
      <footer class="pullquote-footer">
        <img src="/champ.jpeg" alt="Champ" class="quote-headshot" />
        <span class="quote-attr">Champ&nbsp;·&nbsp;Agency owner</span>
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .proof {
    padding: clamp(100px, 14vh, 180px) 48px;
    background: var(--paper);
    color: var(--ink);
  }
  .proof-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  .proof-bridge {
    margin-bottom: clamp(64px, 9vh, 120px);
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    max-width: 900px;
  }
  .bridge-h2 {
    font-family: "Geist", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
    text-wrap: balance;
  }
  .bridge-sub {
    font-family: "Geist", system-ui, sans-serif;
    font-size: clamp(17px, 1.4vw, 21px);
    font-weight: 400;
    line-height: 1.5;
    color: #555;
    margin: 24px auto 0;
    max-width: 46ch;
    text-wrap: pretty;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
  }
  .proof-stack {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 480px;
  }
  .proof-text-1 {
    position: absolute;
    top: 8%;
    left: 4%;
    width: 62%;
  }
  .proof-text-2 {
    position: absolute;
    bottom: 4%;
    right: 2%;
    width: 58%;
  }
  .text-artifact {
    transform: rotate(var(--rotate));
    filter:
      drop-shadow(0 30px 50px rgba(0, 0, 0, 0.18))
      drop-shadow(0 8px 18px rgba(0, 0, 0, 0.08));
    width: 100%;
    border-radius: 22px;
    overflow: hidden;
    background: #1c1c1e;
    position: relative;
    z-index: var(--z);
  }
  .text-artifact img { width: 100%; }
  .stats {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .stat {
    border-top: 1px solid #ECECEC;
    padding-top: 28px;
  }
  .stat.first {
    border-top: none;
    padding-top: 0;
  }
  .stat-big {
    font-family: "Geist", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 80px);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }
  .stat-label {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 18px;
    color: #555;
  }
  .pullquote {
    margin: clamp(80px, 10vh, 140px) 0 0;
    padding: 0;
    font-family: "Geist", system-ui, sans-serif;
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 52px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 22ch;
    text-wrap: balance;
  }
  .quote-mark { color: #bbb; }
  .pullquote-footer {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .quote-headshot {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid #ECECEC;
  }
  .quote-attr {
    font-family: "Geist Mono", ui-monospace, monospace;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #999;
  }
</style>
